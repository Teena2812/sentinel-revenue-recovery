# Python cache & compiled files
__pycache__/
*.pyc
*.pyo

# Virtual environments
.venv/
venv/

# Environment files (never commit API keys)
.env
.env.*
*.env

# Temporary / local runtime artifacts
data/tmp_*.json
*.tmp
powershell.bat
.DS_Store
Thumbs.db

# NOTE: data/, reports/, and data/agent_memory.json are intentionally NOT ignored.
# These contain real proof artifacts (benchmark CSVs, live Gemini proof, memory stats)
# and must be tracked in version control.

